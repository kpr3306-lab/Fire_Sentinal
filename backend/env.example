# Copy this file to .env and fill in your own values. .env is never committed.

# Telegram — create a bot via @BotFather, get your chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP — use an App Password (Google Account > Security > App Passwords),
# NOT your normal Gmail login password.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=

# Optional: second Telegram chat that plays the fire department (SIMULATED dispatch)
TELEGRAM_FIRE_DEPT_SIM_CHAT_ID=
# Optional dispatch tuning
# DISPATCH_COUNTDOWN_S=30
# DASHBOARD_URL=http://localhost:5173
# PUBLIC_BACKEND_URL=http://192.168.x.x:5000
